# Copy this file to .env and adjust as needed. .env itself is gitignored,
# this example file is the only one that should ever be committed.

# Phase 1 (demo) points at a local SQLite file. Phase 2 swaps this for a
# Postgres connection string on the client's own infrastructure, and the
# datasource provider in prisma/schema.prisma changes from "sqlite" to
# "postgresql" to match, see CLAUDE.md's build order.
DATABASE_URL="file:./dev.db"
